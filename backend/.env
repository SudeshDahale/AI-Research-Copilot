# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# --- App ---
APP_NAME=Arclight
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Local (non-Docker) default. When running via docker-compose, the backend
# container overrides this to point at the "postgres" service instead.
DATABASE_URL=postgresql+asyncpg://arclight:arclight@localhost:5433/arclight

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Auth (wired up in Sprint 1) ---
JWT_SECRET=a8f3k2n9x7q1w5e8r3t6y9u2i5o8p1a4s7d0f3g6h9
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- LLM (wired up in Sprint 5) ---
LLM_API_KEY=

# --- CORS ---
# Comma-separated list of origins allowed to call the API.
# Add whatever port `npm run dev` prints for the frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080